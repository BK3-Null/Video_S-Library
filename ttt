<?php
session_start();

// Proteksi session & pemrosesan via metode POST saja
if (!isset($_SESSION['username'])) {
    header("Location: login.php");
    exit;
}

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    header("Location: penjualan.php");
    exit;
}

// Ambil data dari $_POST dan lakukan trim/validasi awal
$target_pendapatan_raw = trim($_POST['target_pendapatan'] ?? '');

$nama_menu = [];
$harga     = [];
$jumlah    = [];
$errors    = [];

for ($i = 1; $i <= 4; $i++) {
    $nama_menu[$i] = trim($_POST["nama_menu$i"] ?? '');
    $harga[$i]     = trim($_POST["harga$i"] ?? '');
    $jumlah[$i]    = trim($_POST["jumlah$i"] ?? '');
}

// Validasi Data
if ($target_pendapatan_raw === '' || !ctype_digit($target_pendapatan_raw) || (int)$target_pendapatan_raw <= 0) {
    $errors[] = "Target pendapatan harian harus berupa bilangan bulat lebih dari nol.";
}

for ($i = 1; $i <= 4; $i++) {
    if ($nama_menu[$i] === '') {
        $errors[] = "Nama menu ke-$i tidak boleh kosong.";
    }
    if ($harga[$i] === '' || !ctype_digit($harga[$i]) || (int)$harga[$i] <= 0) {
        $errors[] = "Harga satuan untuk menu ke-$i harus berupa bilangan bulat lebih dari nol.";
    }
    if ($jumlah[$i] === '' || !ctype_digit($jumlah[$i]) || (int)$jumlah[$i] < 0) {
        $errors[] = "Jumlah porsi terjual untuk menu ke-$i harus berupa bilangan bulat minimal nol.";
    }
}

// Jika terdapat error validasi, tampilkan pesan kesalahan
if (!empty($errors)) {
    echo "<h2>Terjadi Kesalahan Validasi Input</h2>";
    echo "<ul style='color: red;'>";
    foreach ($errors as $err) {
        echo "<li>" . htmlspecialchars($err) . "</li>";
    }
    echo "</ul>";
    echo "<p><a href='penjualan.php'>&laquo; Kembali ke Form Penjualan</a> | <a href='dashboard.php'>Dashboard</a></p>";
    exit;
}

// Konversi ke tipe angka
$target_pendapatan = (int)$target_pendapatan_raw;
$total_porsi_terjual = 0;
$total_pendapatan = 0;
$penjualan_menu = [];

for ($i = 1; $i <= 4; $i++) {
    $h = (int)$harga[$i];
    $j = (int)$jumlah[$i];
    $subtotal = $h * $j;

    $penjualan_menu[] = [
        'nama'       => $nama_menu[$i],
        'harga'      => $h,
        'jumlah'     => $j,
        'pendapatan' => $subtotal
    ];

    $total_porsi_terjual += $j;
    $total_pendapatan += $subtotal;
}

// Perhitungan status dan selisih
if ($total_pendapatan < $target_pendapatan) {
    $status = "Target belum tercapai";
    $selisih_val = $target_pendapatan - $total_pendapatan;
    $selisih_text = "Kekurangan : Rp" . number_format($selisih_val, 0, ',', '.');
    $pesan_evaluasi = "Target pendapatan belum tercapai. Evaluasi penjualan hari ini.";
} elseif ($total_pendapatan == $target_pendapatan) {
    $status = "Target tepat tercapai";
    $selisih_text = "Selisih : Rp0";
    $pesan_evaluasi = "Target pendapatan hari ini tepat tercapai.";
} else {
    $status = "Target terlampaui";
    $selisih_val = $total_pendapatan - $target_pendapatan;
    $selisih_text = "Kelebihan : Rp" . number_format($selisih_val, 0, ',', '.');
    $pesan_evaluasi = "Pendapatan hari ini berhasil melampaui target.";
}
