// 4. Menampilkan item data penerimaan terbesar bulanan secara otomatis
void penerimaanTerbesar() {
    FILE *pf;
    struct Transaksi t, listMaks[100];
    int blnTglUnik[100][2], jmlBulan = 0, i, idx;
    
    if ((pf = fopen("KEUANGAN.DAT", "rb")) == NULL) {
        printf("\nBelum ada data keuangan yang tercatat.\n"); getch(); return;
    }
    
    while (fread(&t, sizeof(struct Transaksi), 1, pf) == 1) {
        if (t.jenis == 1) {
            idx = -1;
            for (i = 0; i < jmlBulan; i++) {
                if (blnTglUnik[i][0] == t.tgl.bulan && blnTglUnik[i][1] == t.tgl.tahun) { idx = i; break; }
            }
            if (idx == -1) {
                blnTglUnik[jmlBulan][0] = t.tgl.bulan; blnTglUnik[jmlBulan][1] = t.tgl.tahun;
                listMaks[jmlBulan] = t; jmlBulan++;
            } else {
                if (t.nominal > listMaks[idx].nominal) listMaks[idx] = t;
            }
        }
    }
    fclose(pf);
    
    system("cls");
    printf("=================================================================\n");
    printf("           DAFTAR PENERIMAAN TERBESAR DARI SETIAP BULAN           \n");
    printf("=================================================================\n");
    if (jmlBulan == 0) printf("Tidak ada data transaksi penerimaan.\n");
    for (i = 0; i < jmlBulan; i++) {
        printf("Bulan Periode: %02d-%d\n", blnTglUnik[i][0], blnTglUnik[i][1]);
        printf(" -> No Rec: %d | Tgl: %02d-%02d-%d | Uraian: %s | Terbesar: Rp %.2f\n",
               listMaks[i].no_catatan, listMaks[i].tgl.hari, listMaks[i].tgl.bulan, listMaks[i].tgl.tahun, listMaks[i].uraian, listMaks[i].nominal);
        printf("-----------------------------------------------------------------\n");
    }
    printf("\nTekan tombol apa saja untuk kembali...");
    getch();
}

