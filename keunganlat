#include <stdio.h>
#include <conio.h>
#include <stdlib.h>
#include <string.h>

// Struktur data transaksi sesuai ketentuan soal
struct data_transaksi {
    int tanggal;
    int bulan;
    int tahun;
    long int total_transaksi;
};

// Variabel global agar mudah diakses oleh modul-modul
struct data_transaksi trans;
FILE *PF;

// =========================================================================
// MODUL 1: Mencatat data transaksi baru ke file "TRANS.DAT"
// =========================================================================
void catatTransaksi() {
    char ulang;
    
    // Membuka file dengan mode "ab" (append binary) agar menambah data di akhir
    if ((PF = fopen("TRANS.DAT", "ab")) == NULL) {
        puts("File TRANS.DAT tidak dapat dibuka/dibuat...!");
        getch();
        return;
    }
    
    ulang = 'Y';
    while (ulang == 'Y' || ulang == 'y') {
        clrscr();
        printf("--- INPUT DATA TRANSAKSI BARU ---\n\n");
        printf("Tanggal (DD)    : "); scanf("%d", &trans.tanggal);
        printf("Bulan (MM)      : "); scanf("%d", &trans.bulan);
        printf("Tahun (YYYY)    : "); scanf("%d", &trans.tahun);
        printf("Total Transaksi : "); scanf("%ld", &trans.total_transaksi);
        
        // Menulis struktur data ke file
        fwrite(&trans, sizeof(trans), 1, PF);
        
        printf("\nMau menginput data lagi (Y/T)? ");
        ulang = getche();
    }
    
    fclose(PF);
}

// =========================================================================
// MODUL 2: Menampilkan data berdasarkan Bulan & Tahun tertentu dari TRANS.DAT
// =========================================================================
void tampilkanBerdasarkanBulanTahun() {
    int cari_bulan, cari_tahun;
    int ditemukan = 0;
    
    if ((PF = fopen("TRANS.DAT", "rb")) == NULL) {
        puts("\nFile TRANS.DAT belum ada atau tidak dapat dibuka...!");
        getch();
        return;
    }
    
    clrscr();
    printf("--- TAMPILKAN BERDASARKAN BULAN & TAHUN ---\n\n");
    printf("Masukkan Bulan yang dicari : "); scanf("%d", &cari_bulan);
    printf("Masukkan Tahun yang dicari : "); scanf("%d", &cari_tahun);
    
    printf("\nHasil Pencarian:\n");
    printf("===========================================\n");
    printf(" Tanggal | Bulan | Tahun | Total Transaksi \n");
    printf("===========================================\n");
    
    // Membaca file record demi record sampai akhir file
    while (fread(&trans, sizeof(trans), 1, PF) == 1) {
        if (trans.bulan == cari_bulan && trans.tahun == cari_tahun) {
            printf("   %2d    |   %2d  | %4d  | Rp. %ld\n", 
                    trans.tanggal, trans.bulan, trans.tahun, trans.total_transaksi);
            ditemukan = 1;
        }
    }
    
    if (!ditemukan) {
        printf(" Data tidak ditemukan untuk bulan %d tahun %d.\n", cari_bulan, cari_tahun);
    }
    printf("===========================================\n");
    fclose(PF);
    getch();
}

// =========================================================================
// MODUL 3: Mencari nilai total transaksi pada tanggal spesifik
// =========================================================================
void cariTransaksiTanggal() {
    int cari_tg, cari_bl, cari_th;
    int ditemukan = 0;
    
    if ((PF = fopen("TRANS.DAT", "rb")) == NULL) {
        puts("\nFile TRANS.DAT belum ada atau tidak dapat dibuka...!");
        getch();
        return;
    }
    
    clrscr();
    printf("--- CARI TRANSAKSI PADA TANGGAL TERTENTU ---\n\n");
    printf("Tanggal : "); scanf("%d", &cari_tg);
    printf("Bulan   : "); scanf("%d", &cari_bl);
    printf("Tahun   : "); scanf("%d", &cari_th);
    
    while (fread(&trans, sizeof(trans), 1, PF) == 1) {
        if (trans.tanggal == cari_tg && trans.bulan == cari_bl && trans.tahun == cari_th) {
            printf("\n>> DITEMUKAN: Nilai total transaksi pada %d-%d-%d adalah: Rp. %ld\n", 
                    trans.tanggal, trans.bulan, trans.tahun, trans.total_transaksi);
            ditemukan = 1;
            break; // Berhenti jika sudah ketemu
        }
    }
    
    if (!ditemukan) {
        printf("\n>> Data transaksi untuk tanggal %d-%d-%d TIDAK ditemukan.\n", cari_tg, cari_bl, cari_th);
    }
    
    fclose(PF);
    getch();
}

// =========================================================================
// MODUL 4: Mengurutkan data (ASCENDING) & disimpan ke "SRTRAN.DAT"
// =========================================================================
void urutkanDanSimpan() {
    int cari_bulan, cari_tahun;
    int i, j, n = 0;
    struct data_transaksi list_trans[100]; // Array penampung sementara
    struct data_transaksi temp;
    FILE *PF_OUT;
    
    if ((PF = fopen("TRANS.DAT", "rb")) == NULL) {
        puts("\nFile TRANS.DAT belum ada atau tidak dapat dibuka...!");
        getch();
        return;
    }
    
    clrscr();
    printf("--- PROSES PENGURUTAN DATA (ASCENDING) ---\n\n");
    printf("Masukkan Bulan yang akan diurutkan: "); scanf("%d", &cari_bulan);
    printf("Masukkan Tahun yang akan diurutkan: "); scanf("%d", &cari_tahun);
    
    // 1. Ambil data yang sesuai dari TRANS.DAT dimasukkan ke array penampung
    while (fread(&trans, sizeof(trans), 1, PF) == 1) {
        if (trans.bulan == cari_bulan && trans.tahun == cari_tahun) {
            list_trans[n] = trans;
            n++;
        }
    }
    fclose(PF);
    
    if (n == 0) {
        printf("\nTidak ada data transaksi pada bulan & tahun tersebut untuk diurutkan.\n");
        getch();
        return;
    }
    
    // 2. Lakukan pengurutan Ascending (Bubble Sort) berdasarkan total_transaksi
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++) {
            if (list_trans[j].total_transaksi > list_trans[j+1].total_transaksi) {
                temp = list_trans[j];
                list_trans[j] = list_trans[j+1];
                list_trans[j+1] = temp;
            }
        }
    }
    
    // 3. Simpan data yang sudah terurut ke file "SRTRAN.DAT" (mode "wb" menimpa isi lama)
    if ((PF_OUT = fopen("SRTRAN.DAT", "wb")) == NULL) {
        puts("File SRTRAN.DAT tidak dapat dibuat...!");
        getch();
        return;
    }
    
    for (i = 0; i < n; i++) {
        fwrite(&list_trans[i], sizeof(struct data_transaksi), 1, PF_OUT);
    }
    fclose(PF_OUT);
    
    printf("\n%d Data berhasil diurutkan dan disimpan ke file SRTRAN.DAT!\n", n);
    getch();
}

// =========================================================================
// MODUL 5: Menampilkan isi seluruh file "SRTRAN.DAT"
// =========================================================================
void tampilkanSRTRAN() {
    if ((PF = fopen("SRTRAN.DAT", "rb")) == NULL) {
        puts("\nFile SRTRAN.DAT belum ada. Silakan lakukan menu pengurutan (Menu 4) terlebih dahulu!");
        getch();
        return;
    }
    
    clrscr();
    printf("--- ISI FILE SRTRAN.DAT (DATA TERURUT ASCENDING) ---\n\n");
    printf("===========================================\n");
    printf(" Tanggal | Bulan | Tahun | Total Transaksi \n");
    printf("===========================================\n");
    
    while (fread(&trans, sizeof(trans), 1, PF) == 1) {
        printf("   %2d    |   %2d  | %4d  | Rp. %ld\n", 
                trans.tanggal, trans.bulan, trans.tahun, trans.total_transaksi);
    }
    
    printf("===========================================\n");
    fclose(PF);
    getch();
}

// =========================================================================
// MAIN PROGRAM: Menu Utama
// =========================================================================
main() {
    int pilihan;
    
    do {
        clrscr();
        printf("==============================================\n");
        printf("         APLIKASI KASIR MINIMARKET            \n");
        printf("==============================================\n");
        printf(" 1. Catat Total Transaksi Harian (TRANS.DAT)\n");
        printf(" 2. Tampilkan Transaksi (Bulan & Tahun)\n");
        printf(" 3. Cari Transaksi Berdasarkan Tanggal\n");
        printf(" 4. Urutkan Transaksi Ascending (SRTRAN.DAT)\n");
        printf(" 5. Tampilkan Isi File SRTRAN.DAT\n");
        printf(" 6. Keluar Program\n");
        printf("==============================================\n");
        printf("Pilihan Anda [1-6] : "); scanf("%d", &pilihan);
        
        switch(pilihan) {
            case 1: catatTransaksi(); break;
            case 2: tampilkanBerdasarkanBulanTahun(); break;
            case 3: cariTransaksiTanggal(); break;
            case 4: urutkanDanSimpan(); break;
            case 5: tampilkanSRTRAN(); break;
            case 6: puts("\nTerima kasih! Program selesai."); getch(); break;
            default: puts("\nPilihan salah! Tekan sembarang tombol..."); getch();
        }
    } while (pilihan != 6);
}
