// 4. Menampilkan item data penerimaan yang terbesar dalam bulan tertentu
void penerimaanTerbesar() {
	FILE *pf;
	struct Transaksi t;
	struct Transaksi maks;
	int b, y;
	int ditemukan = 0;

	if ((pf = fopen("KEUANGAN.DAT", "rb")) == NULL) {
		printf("\nBelum ada data keuangan yang tercatat.\n");
		getch();
		return;
	}

	system("cls");
	printf("--- CARI PENERIMAAN TERBESAR BULANAN ---\n");
	printf("Masukkan Bulan dan Tahun (MM YYYY): ");
	scanf("%d %d", &b, &y);

	maks.nominal = -1; // Set nilai awal pembanding ke nilai terendah

	while (fread(&t, sizeof(struct Transaksi), 1, pf) == 1) {
		if (t.jenis == 1 && t.tgl.bulan == b && t.tgl.tahun == y) {
			if (t.nominal > maks.nominal) {
				maks = t;
				ditemukan = 1;
			}
		}
	}

	fclose(pf);

	printf("\n==================================================\n");
	if (ditemukan) {
		printf("Item Penerimaan Terbesar pada Bulan %02d-%d adalah:\n", b, y);
		printf("No Catatan Transaksi : %d\n", maks.no_catatan);
		printf("Tanggal Transaksi    : %02d-%02d-%d\n", maks.tgl.hari, maks.tgl.bulan, maks.tgl.tahun);
		printf("Uraian / Keterangan  : %s\n", maks.uraian);
		printf("Nominal Maksimal     : Rp %.2f\n", maks.nominal);
	} else {
		printf("Tidak ada data penerimaan pada bulan %02d-%d.\n", b, y);
	}
	printf("==================================================\n");
	printf("\nTekan tombol apa saja untuk kembali...");
	getch();
}

