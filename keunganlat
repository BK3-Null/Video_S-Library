// 6. Mengedit nominal dengan teknik Random Access File (fseek) pada file .dat
void editNominal() {
    FILE *pf;
    struct Transaksi t;
    int no_cari, ditemukan = 0;
    double nominal_baru;
    
    if ((pf = fopen("KEUANGAN.DAT", "r+b")) == NULL) {
        printf("\nBelum ada data keuangan yang tercatat.\n"); getch(); return;
    }
    
    system("cls");
    printf("--- EDIT NOMINAL DATA TRANSAKSI ---\n");
    printf("Masukkan Nomor Catatan Transaksi yang ingin diedit: ");
    scanf("%d", &no_cari);
    
    while (fread(&t, sizeof(struct Transaksi), 1, pf) == 1) {
        if (t.no_catatan == no_cari) {
            ditemukan = 1;
            printf("\nData Lama Ditemukan: %s | Nominal Lama: Rp %.2f\n", t.uraian, t.nominal);
            printf("Masukkan Nominal Baru (Rp): ");
            scanf("%lf", &nominal_baru);
            t.nominal = nominal_baru;
            
            // Mundurkan pointer file 1 struct ke belakang untuk menimpa record yang sedang dibaca
            fseek(pf, -sizeof(struct Transaksi), SEEK_CUR);
            fwrite(&t, sizeof(struct Transaksi), 1, pf);
            break;
        }
    }
    
    fclose(pf);
    
    if (ditemukan) printf("\nNominal berhasil diperbarui di file biner KEUANGAN.DAT!\n");
    else printf("\nNomor catatan tidak ditemukan...\n");
    
    printf("\nTekan tombol apa saja untuk kembali ke menu utama...");
    getch();
}
