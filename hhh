session_start();

// Proteksi halaman
if (!isset($_SESSION['username'])) {
    header("Location: login.php");
    exit();
}

// A. Ambil Data dari $_POST
$senin  = $_POST['tidur_senin'] ?? null;
$selasa = $_POST['tidur_selasa'] ?? null;
$rabu   = $_POST['tidur_rabu'] ?? null;
$kamis  = $_POST['tidur_kamis'] ?? null;
$jumat  = $_POST['tidur_jumat'] ?? null;
$sabtu  = $_POST['tidur_sabtu'] ?? null;
$minggu = $_POST['tidur_minggu'] ?? null;

// Simpan data dalam array untuk mempermudah pengecekan dan pengolahan
$data_tidur = [
    'Senin'  => $senin,
    'Selasa' => $selasa,
    'Rabu'   => $rabu,
    'Kamis'  => $kamis,
    'Jumat'  => $jumat,
    'Sabtu'  => $sabtu,
    'Minggu' => $minggu
];

// B. Validasi Data
$ada_error = false;
$pesan_error = "";

foreach ($data_tidur as $hari => $jam) {
    if ($jam === null || $jam === '' || !is_numeric($jam) || $jam < 0 || $jam > 24) {
        $ada_error = true;
        $pesan_error = "Jam tidur untuk hari $hari tidak valid! Jam tidur harus diisi angka antara 0 sampai 24.";
        break;
    }
}

// Jika ada error pada input, tampilkan pesan dan link navigasi
if ($ada_error) {
    echo "<p style='color: red;'>$pesan_error</p>";
    echo "<p><a href='tidur.php'>Kembali ke tidur.php</a></p>";
    echo "<p><a href='dashboard.php'>Kembali ke dashboard.php</a></p>";
    exit();
}

// C. Perhitungan (Tanpa membuat function baru)
$total_jam = $senin + $selasa + $rabu + $kamis + $jumat + $sabtu + $minggu;
$rata_rata = $total_jam / 7;

// Hitung hari kurang tidur (< 7 jam) dan tentukan status tiap hari
$jumlah_hari_kurang = 0;
$status_hari = [];

foreach ($data_tidur as $hari => $jam) {
    if ($jam < 7) {
        $status_hari[$hari] = "Kurang";
        $jumlah_hari_kurang++;
    } else {
        $status_hari[$hari] = "Cukup";
    }
}
?>
