// 6. Mengedit item data nominal di dalam file TXT
void editNominal() {
    FILE *pf, *pTemp;
    struct Transaksi t;
    int no_cari, ditemukan = 0;
    double nominal_baru;
    
    if ((pf = fopen("KEUANGAN.txt", "r")) == NULL) {
        printf("\nBelum ada data keuangan yang tercatat.\n"); getch(); return;
    }
    
    // Gunakan file temporary untuk menulis ulang data modifikasi karena ini file TXT
    pTemp = fopen("TEMP.txt", "w");
    
    system("cls");
    printf("--- EDIT NOMINAL DATA TRANSAKSI ---\n");
    printf("Masukkan Nomor Catatan Transaksi yang ingin diedit: ");
    scanf("%d", &no_cari);
    
    while (fscanf(pf, "%d;%d;%d;%d;%[^;];%d;%lf\n", &t.no_catatan, &t.tgl.hari, &t.tgl.bulan, &t.tgl.tahun, t.uraian, &t.jenis, &t.nominal) != EOF) {
        if (t.no_catatan == no_cari) {
            ditemukan = 1;
            printf("\nData Ditemukan: %s | Nominal Lama: Rp %.2f\n", t.uraian, t.nominal);
            printf("Masukkan Nominal Baru (Rp): ");
            scanf("%lf", &nominal_baru);
            t.nominal = nominal_baru;
        }
        // Tulis data (baik yang diubah atau yang tetap) ke file temp
        fprintf(pTemp, "%d;%d;%d;%d;%s;%d;%.2f\n", t.no_catatan, t.tgl.hari, t.tgl.bulan, t.tgl.tahun, t.uraian, t.jenis, t.nominal);
    }
    
    fclose(pf);
    fclose(pTemp);
    
    // Ganti file asli dengan file temporary yang sudah diperbarui
    remove("KEUANGAN.txt");
    rename("TEMP.txt", "KEUANGAN.txt");
    
    if (ditemukan) printf("\nNominal berhasil diperbarui di file TXT!\n");
    else printf("\nNomor catatan tidak ditemukan...\n");
    
    printf("\nTekan tombol apa saja untuk kembali...");
    getch();
}
