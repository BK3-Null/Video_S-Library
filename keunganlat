// 6. Mengedit item data penerimaan/pengeluaran (Nominalnya) dengan Random Access File
void editNominal() {
	FILE *pf;
	struct Transaksi t;
	int no_cari;
	int ditemukan = 0;
	double nominal_baru;

	// Mode "r+b" digunakan agar file bisa dibaca sekaligus ditulis tanpa menghapus isi awal file
	if ((pf = fopen("KEUANGAN.DAT", "r+b")) == NULL) {
		printf("\nBelum ada data keuangan yang tercatat atau file gagal dibuka.\n");
		getch();
		return;
	}

	system("cls");
	printf("--- EDIT NOMINAL DATA TRANSAKSI ---\n");
	printf("Masukkan Nomor Catatan Transaksi yang ingin diedit: ");
	scanf("%d", &no_cari);

	while (fread(&t, sizeof(struct Transaksi), 1, pf) == 1) {
		if (t.no_catatan == no_cari) {
			ditemukan = 1;

			printf("\nData Lama Ditemukan:\n");
			printf("Tanggal  : %02d-%02d-%d\n", t.tgl.hari, t.tgl.bulan, t.tgl.tahun);
			printf("Uraian   : %s\n", t.uraian);
			printf("Jenis    : %s\n", (t.jenis == 1) ? "Penerimaan" : "Pengeluaran");
			printf("Nominal  : Rp %.2f\n", t.nominal);
			printf("------------------------------------------\n");

			printf("Masukkan Nominal Baru (Rp): ");
			scanf("%lf", &nominal_baru);
			t.nominal = nominal_baru;

			// Memundurkan internal pointer file sejauh ukuran struct untuk menimpa record yang tepat
			fseek(pf, -sizeof(struct Transaksi), SEEK_CUR);

			// Menulis ulang data terupdate ke file biner
			fwrite(&t, sizeof(struct Transaksi), 1, pf);
			printf("\nNominal transaksi berhasil diperbarui!\n");
			break;
		}
	}

	if (!ditemukan) {
		printf("\nNomor Catatan Transaksi %d tidak ditemukan...\n", no_cari);
	}

	fclose(pf);
	printf("\nTekan tombol apa saja untuk kembali ke menu utama...");
	getch();
