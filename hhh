                <tr>
                    <td><?php echo $hari; ?></td>
                    <td><?php echo number_format($jam, 1, ',', ''); ?> jam</td>
                    <td><?php echo $status_hari[$hari]; ?></td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>

    <br>
    <p>Total jam tidur minggu ini: <strong><?php echo number_format($total_jam, 1, ',', ''); ?> jam</strong></p>
    <p>Rata-rata jam tidur per hari: <strong><?php echo number_format($rata_rata, 1, ',', ''); ?> jam</strong></p>
    <p>Jumlah hari kurang dari 7 jam tidur: <strong><?php echo $jumlah_hari_kurang; ?> hari</strong></p>

    <br>
    <!-- E. Pesan Evaluasi -->
    <?php
    if ($rata_rata < 7) {
        echo "<p style='color: orange;'>Rata-rata tidur kamu kurang dari 7 jam per hari. Coba perbaiki pola tidur ya.</p>";
    }

    if ($jumlah_hari_kurang >= 4) {
        echo "<p style='color: red;'>Banyak hari kurang tidur (4 hari atau lebih). Tubuh kamu butuh istirahat lebih.</p>";
    }

    if ($rata_rata >= 7 && $jumlah_hari_kurang < 4) {
        echo "<p style='color: green;'>Pola tidurmu cukup baik. Pertahankan ya!</p>";
    }
