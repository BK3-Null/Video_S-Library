#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <conio.h>

// Struktur data untuk Tanggal
struct Tanggal {
    int hari;
    int bulan;
    int tahun;
};

// Struktur data untuk Catatan Transaksi Keuangan
struct Transaksi {
    int no_catatan;
    struct Tanggal tgl;
    char uraian[50];
    int jenis; // 1 = Penerimaan, 2 = Pengeluaran
    double nominal;
};

// Deklarasi fungsi-fungsi modular
void catatData();
void laporanPenerimaan();
void laporanPengeluaran();
void penerimaanTerbesar();
void pengeluaranTerbesar();
void editNominal();
int cekNoCatatan(int no);

int main() {
    int pilihan;
    
    do {
        system("cls"); // Membersihkan layar console
        printf("=== PROGRAM APLIKASI KEUANGAN KELUARGA (VERSI FILE TXT) ===\n");
        printf("1. Mencatat Data Penerimaan / Pengeluaran\n");
        printf("2. Menampilkan Detail Laporan Penerimaan (Harian/Bulanan)\n");
        printf("3. Menampilkan Detail Laporan Pengeluaran (Harian/Bulanan)\n");
        printf("4. Menampilkan Item Data Penerimaan Terbesar Bulanan Otomatis\n");
        printf("5. Menampilkan Item Data Pengeluaran Terbesar Bulanan Otomatis\n");
        printf("6. Mengedit Nominal Item Data Penerimaan / Pengeluaran\n");
        printf("7. Keluar dari Program Aplikasi\n");
        printf("============================================================\n");
        printf("Masukkan Pilihan Anda (1-7): ");
        scanf("%d", &pilihan);
        
        switch(pilihan) {
            case 1: catatData(); break;
            case 2: laporanPenerimaan(); break;
            case 3: laporanPengeluaran(); break;
            case 4: penerimaanTerbesar(); break;
            case 5: pengeluaranTerbesar(); break;
            case 6: editNominal(); break;
            case 7: 
                printf("\nTerima kasih telah menggunakan aplikasi ini!\n"); 
                break;
            default: 
                printf("\nPilihan tidak valid! Silakan tekan tombol apa saja untuk mengulang...");
                getch();
        }
    } while(pilihan != 7);
    
    return 0;
}

// 1. Fungsi mencatat data penerimaan/pengeluaran ke file TXT
void catatData() {
    FILE *pf;
    struct Transaksi t;
    char ulang;
    
    // Membuka file txt dengan mode "a" (append text)
    if ((pf = fopen("KEUANGAN.txt", "a")) == NULL) {
        printf("\nFile data tidak dapat dibuka/dibuat!\n");
        getch();
        return;
    }
    
    do {
        system("cls");
        printf("--- MENCATAT DATA TRANSAKSI ---\n");
        
        printf("Masukkan No Catatan Transaksi: ");
        scanf("%d", &t.no_catatan);
        
        if (cekNoCatatan(t.no_catatan)) {
            printf("Error: No Catatan Transaksi %d sudah ada!\n", t.no_catatan);
            printf("\nMau memasukkan data lagi (Y/T)? ");
            ulang = getche();
            continue;
        }
        
        printf("Masukkan Tanggal (DD MM YYYY) misal 15 07 2026: ");
        scanf("%d %d %d", &t.tgl.hari, &t.tgl.bulan, &t.tgl.tahun);
        
        printf("Masukkan Uraian/Keterangan   : ");
        fflush(stdin); 
        gets(t.uraian);
        
        do {
            printf("Jenis Transaksi (1=Penerimaan, 2=Pengeluaran): ");
            scanf("%d", &t.jenis);
        } while (t.jenis != 1 && t.jenis != 2);
        
        printf("Masukkan Nominal (Rp)         : ");
        scanf("%lf", &t.nominal);
        
        // Menyimpan ke file teks dengan format terstruktur agar mudah dibaca kembali oleh program
        fprintf(pf, "%d;%d;%d;%d;%s;%d;%.2f\n", 
                t.no_catatan, t.tgl.hari, t.tgl.bulan, t.tgl.tahun, t.uraian, t.jenis, t.nominal);
                
        printf("\nData berhasil disimpan ke file KEUANGAN.txt!");
        
        printf("\nMau memasukkan data lagi (Y/T)? ");
        ulang = getche();
    } while (ulang == 'Y' || ulang == 'y');
    
    fclose(pf);
}

// Fungsi pembantu mengecek keunikan ID di file TXT
int cekNoCatatan(int no) {
    FILE *pf;
    struct Transaksi t;
    int ditemukan = 0;
    
    if ((pf = fopen("KEUANGAN.txt", "r")) == NULL) {
        return 0;
    }
    
    while (fscanf(pf, "%d;%d;%d;%d;[^;];%d;%lf\n", 
                  &t.no_catatan, &t.tgl.hari, &t.tgl.bulan, &t.tgl.tahun, t.uraian, &t.jenis, &t.nominal) != EOF) {
        if (t.no_catatan == no) {
            ditemukan = 1;
            break;
        }
    }
    fclose(pf);
    return ditemukan;
}

// 2. Laporan Penerimaan (Pilihan Harian/Bulanan Otomatis langsung keluar semua)
void laporanPenerimaan() {
    FILE *pf;
    struct Transaksi t;
    int mode, i, j, adaData, sudahTampil;
    int tglUnik[500][3]; // Tampung tanggal unik [hari, bulan, tahun]
    int jmlTgl = 0;
    double totalPeriode, totalSemua = 0;
    
    if ((pf = fopen("KEUANGAN.txt", "r")) == NULL) {
        printf("\nBelum ada data keuangan yang tercatat.\n");
        getch();
        return;
    }
    
    system("cls");
    printf("--- DETAIL LAPORAN PENERIMAAN ---\n");
    printf("1. Tampilkan Semua Laporan Harian Otomatis\n");
    printf("2. Tampilkan Semua Laporan Bulanan Otomatis\n");
    printf("Pilih Mode Tampilan (1-2): ");
    scanf("%d", &mode);
    system("cls");
    
    if (mode == 1) {
        printf("=================================================================\n");
        printf("             LAPORAN PENERIMAAN HARIAN (SEMUA DATA)              \n");
        printf("=================================================================\n");
        
        // Step 1: Cari semua tanggal unik dari file
        while (fscanf(pf, "%d;%d;%d;%d;%[^;];%d;%lf\n", &t.no_catatan, &t.tgl.hari, &t.tgl.bulan, &t.tgl.tahun, t.uraian, &t.jenis, &t.nominal) != EOF) {
            if (t.jenis == 1) {
                sudahTampil = 0;
                for (i = 0; i < jmlTgl; i++) {
                    if (tglUnik[i][0] == t.tgl.hari && tglUnik[i][1] == t.tgl.bulan && tglUnik[i][2] == t.tgl.tahun) {
                        sudahTampil = 1; break;
                    }
                }
                if (!sudahTampil) {
                    tglUnik[jmlTgl][0] = t.tgl.hari;
                    tglUnik[jmlTgl][1] = t.tgl.bulan;
                    tglUnik[jmlTgl][2] = t.tgl.tahun;
                    jmlTgl++;
                }
            }
        }
        
        // Step 2: Cetak data per tanggal tersebut
        if (jmlTgl == 0) printf("  [ Tidak ada data penerimaan ]\n");
        for (i = 0; i < jmlTgl; i++) {
            printf("\nTanggal: %02d-%02d-%d\n", tglUnik[i][0], tglUnik[i][1], tglUnik[i][2]);
            printf("-----------------------------------------------------------------\n");
            printf("%-7s | %-30s | %-20s\n", "No Rec", "Uraian Keterangan", "Nominal (Rp)");
            printf("-----------------------------------------------------------------\n");
            totalPeriode = 0;
            rewind(pf); // Kembalikan pointer file ke awal
            while (fscanf(pf, "%d;%d;%d;%d;%[^;];%d;%lf\n", &t.no_catatan, &t.tgl.hari, &t.tgl.bulan, &t.tgl.tahun, t.uraian, &t.jenis, &t.nominal) != EOF) {
                if (t.jenis == 1 && t.tgl.hari == tglUnik[i][0] && t.tgl.bulan == tglUnik[i][1] && t.tgl.tahun == tglUnik[i][2]) {
                    printf("%-7d | %-30s | Rp %14.2f\n", t.no_catatan, t.uraian, t.nominal);
                    totalPeriode += t.nominal;
                }
            }
            printf("--> Total Hari Ini: Rp %.2f\n", totalPeriode);
            printf("-----------------------------------------------------------------\n");
            totalSemua += totalPeriode;
        }
        printf("\n>> TOTAL KESELURUHAN PENERIMAAN: Rp %.2f <<\n", totalSemua);
        
    } else if (mode == 2) {
        printf("=================================================================\n");
        printf("             LAPORAN PENERIMAAN BULANAN (SEMUA DATA)             \n");
        printf("=================================================================\n");
        
        // Cari semua Bulan-Tahun unik
        while (fscanf(pf, "%d;%d;%d;%d;%[^;];%d;%lf\n", &t.no_catatan, &t.tgl.hari, &t.tgl.bulan, &t.tgl.tahun, t.uraian, &t.jenis, &t.nominal) != EOF) {
            if (t.jenis == 1) {
                sudahTampil = 0;
                for (i = 0; i < jmlTgl; i++) {
                    if (tglUnik[i][1] == t.tgl.bulan && tglUnik[i][2] == t.tgl.tahun) {
                        sudahTampil = 1; break;
                    }
                }
                if (!sudahTampil) {
                    tglUnik[jmlTgl][1] = t.tgl.bulan;
                    tglUnik[jmlTgl][2] = t.tgl.tahun;
                    jmlTgl++;
                }
            }
        }
        
        if (jmlTgl == 0) printf("  [ Tidak ada data penerimaan ]\n");
        for (i = 0; i < jmlTgl; i++) {
            printf("\nBulan Periode: %02d-%d\n", tglUnik[i][1], tglUnik[i][2]);
            printf("-----------------------------------------------------------------\n");
            printf("%-7s | %-11s | %-25s | %-15s\n", "No Rec", "Tanggal", "Uraian", "Nominal (Rp)");
            printf("-----------------------------------------------------------------\n");
            totalPeriode = 0;
            rewind(pf);
            while (fscanf(pf, "%d;%d;%d;%d;%[^;];%d;%lf\n", &t.no_catatan, &t.tgl.hari, &t.tgl.bulan, &t.tgl.tahun, t.uraian, &t.jenis, &t.nominal) != EOF) {
                if (t.jenis == 1 && t.tgl.bulan == tglUnik[i][1] && t.tgl.tahun == tglUnik[i][2]) {
                    printf("%-7d | %02d-%02d-%d | %-25s | Rp %12.2f\n", t.no_catatan, t.tgl.hari, t.tgl.bulan, t.tgl.tahun, t.uraian, t.nominal);
                    totalPeriode += t.nominal;
                }
            }
            printf("--> Total Bulan Ini: Rp %.2f\n", totalPeriode);
            printf("-----------------------------------------------------------------\n");
            totalSemua += totalPeriode;
        }
        printf("\n>> TOTAL KESELURUHAN PENERIMAAN: Rp %.2f <<\n", totalSemua);
    }
    
    fclose(pf);
    printf("\nTekan tombol apa saja untuk kembali ke menu utama...");
    getch();
}

